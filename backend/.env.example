# Copier ce fichier en ".env" et adapter les valeurs.

# Local (par defaut) : base SQLite dans un fichier.
# Production : coller ici la "Connection string" Postgres de ton projet Supabase.
DATABASE_URL=sqlite:///./sandorhii.db

# Mot de passe unique du back-office (Phase 1 - sera remplace par de vrais
# comptes Supabase). Choisis quelque chose de solide avant le lancement public.
ADMIN_PASSWORD=changeme

# Domaines autorises a appeler cette API, separes par des virgules.
CORS_ORIGINS=http://localhost:3000,https://sandorhii.vercel.app
